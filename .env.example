# Copiá este archivo a .env y completá los valores reales — nunca commitear .env.

# ---- Obligatorias ----

# "memory" para desarrollo sin base real (datos se pierden al reiniciar) o "postgres"
# para usar la base real de Supabase. En producción, "postgres" es obligatorio.
DATABASE_MODE=memory

# Solo hace falta si DATABASE_MODE=postgres. Conexion directa a Postgres en Supabase
# (Project Settings -> Database -> Connection string -> "URI", conexion directa,
# no el pooler de PgBouncer).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Cualquier string largo y aleatorio - firma las cookies de sesion. Generar uno propio
# para cada entorno, nunca reusar el de otro proyecto.
SESSION_SECRET=change-me-for-local-development

# ---- Solo si vas a subir/reemplazar imagenes de productos (Supabase Storage) ----

# Project Settings -> API -> Project URL.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Project Settings -> API -> service_role key (la secreta, NO la "anon" publica). Da acceso
# total a Storage sin pasar por reglas de acceso - solo se usa en el backend, JAMAS debe
# llegar al frontend ni exponerse en el bundle del cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Opcionales ----

# Puerto donde escucha el servidor. Railway/Render suelen inyectar el suyo propio.
PORT=5000

# "development" (default) o "production". En produccion exige DATABASE_MODE=postgres,
# activa cookies "secure" y desactiva la creacion automatica del admin de desarrollo.
NODE_ENV=development

# Solo para correr `npm run create-admin` una vez, para dar de alta el primer admin real
# contra Postgres. Se leen una sola vez desde el entorno de esa ejecucion puntual - no
# hace falta dejarlas seteadas en el .env real de forma permanente.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
